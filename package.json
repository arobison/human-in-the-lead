{
  "name": "human-in-the-lead",
  "version": "0.1.0-rc.1",
  "description": "Agents do the work; people set the direction and make the calls.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "hitld": "core/bin/hitld.mjs"
  },
  "files": [
    "core/bin/",
    "core/lib/",
    "core/harness/",
    "schemas/",
    "templates/",
    "evals/",
    "skills/",
    ".claude-plugin/",
    "plugins/",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node core/test/run.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spelling": "node core/bin/spelling-check.mjs",
    "check": "npm run typecheck && npm run format:check && npm test",
    "build": "node core/lib/packaging/build.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.10.0",
    "typescript": "7.0.2"
  }
}
