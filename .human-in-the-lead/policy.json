{
  "schema_version": 1,
  "project": {
    "id": "human-in-the-lead",
    "key": "HITLD"
  },
  "merge": {
    "mode": "owner",
    "via": "pull-request",
    "pull_request": {
      "checks": [
        "check",
        "typecheck",
        "format",
        "tests",
        "evals",
        "tracker",
        "dco",
        "public",
        "Analyze (actions)",
        "Analyze (javascript-typescript)"
      ],
      "delegated_by": "HITLD-159"
    },
    "owner_paths": ["**", "!work/**"],
    "propose_queue_after": 20,
    "generated": [
      {
        "globs": ["plugins/**"],
        "regenerate": "npm run build"
      }
    ],
    "public_globs": [
      "schemas/**",
      "templates/AGENTS.contract.md",
      "core/lib/cli/**",
      "core/lib/contract/report.mjs",
      "core/lib/tracker/files/api.mjs",
      "core/lib/tracker/interface.mjs",
      "core/harness/interface.mjs"
    ],
    "scanners": [
      {
        "name": "codeql",
        "command": "node \"${HITLD_PRIMARY_ROOT:?set by the hitld merge queue to the primary checkout}/scripts/codeql-scan.mjs\"",
        "format": "sarif"
      }
    ]
  },
  "sweep": {
    "proposed_max_age": 30
  },
  "execution": {
    "max_executors": {
      "value": 4,
      "min": 1,
      "max": 6
    }
  }
}
