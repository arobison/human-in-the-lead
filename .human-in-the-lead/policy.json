{
  "schema_version": 1,
  "project": {
    "id": "human-in-the-lead",
    "key": "HITLD"
  },
  "merge": {
    "mode": "owner",
    "via": "pull-request",
    "pull_request": {
      "checks": [
        "check",
        "typecheck",
        "format",
        "tests",
        "evals",
        "tracker",
        "dco",
        "public",
        "Analyze (actions)",
        "Analyze (javascript-typescript)"
      ],
      "conditional_checks": [
        {
          "name": "CodeQL",
          "unless_only": [
            "work/**",
            "docs/**",
            "**/*.md",
            "**/*.MD",
            "**/*.txt",
            "**/*.TXT",
            "LICENSE"
          ]
        }
      ],
      "delegated_by": "HITLD-159"
    },
    "owner_paths": ["**", "!work/**", "work/releases/**"],
    "propose_queue_after": 20,
    "generated": [
      {
        "globs": ["plugins/**"],
        "regenerate": "npm run build"
      }
    ],
    "public_globs": [
      "schemas/**",
      "templates/AGENTS.contract.md",
      "core/lib/cli/**",
      "core/lib/contract/report.mjs",
      "core/lib/tracker/files/api.mjs",
      "core/lib/tracker/interface.mjs",
      "core/harness/interface.mjs"
    ],
    "scanners": [
      {
        "name": "codeql",
        "command": "node \"${HITLD_PRIMARY_ROOT:?set by the hitld merge queue to the primary checkout}/scripts/codeql-scan.mjs\"",
        "format": "sarif"
      }
    ]
  },
  "rights": {
    "areas": [
      {
        "name": "tracker",
        "paths": [
          "work/*",
          "work/items/**",
          "work/milestones/**",
          "work/projects/**",
          "work/views/**"
        ]
      },
      {
        "name": "releases",
        "paths": ["work/releases/**"]
      },
      {
        "name": "core",
        "paths": ["core/**"]
      },
      {
        "name": "plugins",
        "paths": ["plugins/**"]
      },
      {
        "name": "skills",
        "paths": ["skills/**", "agents/**"]
      },
      {
        "name": "schemas",
        "paths": ["schemas/**"]
      },
      {
        "name": "docs",
        "paths": ["docs/**"]
      },
      {
        "name": "workflows",
        "paths": [".github/**"]
      },
      {
        "name": "scripts",
        "paths": ["scripts/**"]
      },
      {
        "name": "evals",
        "paths": ["evals/**"]
      },
      {
        "name": "templates",
        "paths": ["templates/**"]
      },
      {
        "name": "packaging",
        "paths": ["packaging/**", ".claude-plugin/**"]
      },
      {
        "name": "signals",
        "paths": ["signals/**"]
      },
      {
        "name": "policy",
        "paths": [".human-in-the-lead/**"]
      }
    ]
  },
  "sweep": {
    "proposed_max_age": 30
  },
  "execution": {
    "max_executors": {
      "value": 4,
      "min": 1,
      "max": 6
    }
  }
}
