{
  "$id": "harness-capabilities",
  "title": "Harness capabilities",
  "description": "What a harness adapter supports (design part 15.3). The orchestrator reads it and degrades where a capability is missing.",
  "type": "object",
  "properties": {
    "parallel_subagents": { "type": "boolean" },
    "persistent_sessions": { "type": "boolean" },
    "worktrees": { "type": "boolean" },
    "background_completion": { "type": "boolean" },
    "remote_human_channel": { "type": "boolean" },
    "hooks": { "enum": ["full", "subset", "none"] },
    "model_selection": { "type": "boolean" },
    "effort_selection": { "type": "boolean" },
    "usage_reporting": { "enum": ["tokens", "requests", "none"] },
    "max_classification": { "$ref": "common#/$defs/classification" }
  },
  "required": [
    "parallel_subagents",
    "persistent_sessions",
    "worktrees",
    "background_completion",
    "remote_human_channel",
    "hooks",
    "model_selection",
    "effort_selection",
    "usage_reporting",
    "max_classification"
  ],
  "additionalProperties": false
}
