{
  "schema_version": 1,
  "id": "store/unenrolled-device-cannot-push",
  "suite": "store",
  "category": "store",
  "description": "A device is enrolled only by the owner's own answer to a device decision (design 0003 section 6). A new device puts its request on the store repository's hitld-devices branch; the request alone makes it no recipient, and it cannot push (device-not-enrolled). An approved device puts the request to the owner (hitld store device ask), the owner answers in their own turn, and the approved device is then due a push; its next checkpoint re-seals the store to both devices, the new device pulls the whole history, learns it is approved, and its own push is accepted.",
  "mode": "offline",
  "steps": [
    {
      "id": "project",
      "action": "store.fixture",
      "with": {
        "devices": ["example-laptop", "example-tablet"],
        "enrolled": ["example-laptop"]
      }
    },
    {
      "id": "start",
      "action": "store.hitld",
      "with": {
        "device": "example-laptop",
        "argv": ["run", "start", "--host", "example-laptop"]
      }
    },
    {
      "id": "log_first",
      "action": "store.hitld",
      "with": {
        "device": "example-laptop",
        "argv": [
          "rights",
          "log",
          "--text",
          "Recorded before example-tablet joined",
          "--area",
          "api"
        ]
      }
    },
    {
      "id": "checkpoint_first",
      "action": "store.hitld",
      "with": {
        "device": "example-laptop",
        "argv": ["run", "checkpoint", "--host", "example-laptop"]
      }
    },
    {
      "id": "tablet_push_unenrolled",
      "action": "store.hitld",
      "with": {
        "device": "example-tablet",
        "argv": ["store", "push"]
      }
    },
    {
      "id": "tablet_request",
      "action": "store.hitld",
      "with": {
        "device": "example-tablet",
        "argv": ["store", "device", "init", "--cloud", "--name", "example-tablet"]
      }
    },
    {
      "id": "tablet_push_requested",
      "action": "store.hitld",
      "with": {
        "device": "example-tablet",
        "argv": ["store", "push"]
      }
    },
    {
      "id": "laptop_status_requested",
      "action": "store.hitld",
      "with": {
        "device": "example-laptop",
        "argv": ["store", "status"]
      }
    },
    {
      "id": "laptop_log_again",
      "action": "store.hitld",
      "with": {
        "device": "example-laptop",
        "argv": [
          "rights",
          "log",
          "--text",
          "Recorded while example-tablet only asked",
          "--area",
          "api"
        ]
      }
    },
    {
      "id": "laptop_push_requested",
      "action": "store.hitld",
      "with": {
        "device": "example-laptop",
        "argv": ["store", "push"]
      }
    },
    {
      "id": "remote_requested",
      "action": "store.inspect-remote",
      "with": {
        "open_with": ["example-laptop", "example-tablet"]
      }
    },
    {
      "id": "laptop_ask",
      "action": "store.hitld",
      "with": {
        "device": "example-laptop",
        "argv": ["store", "device", "ask"]
      }
    },
    {
      "id": "laptop_sweep",
      "action": "store.hitld",
      "with": {
        "device": "example-laptop",
        "argv": ["rights", "sweep"]
      }
    },
    {
      "id": "answer",
      "action": "store.owner-answers",
      "with": {
        "device": "example-laptop",
        "answer": "A"
      }
    },
    {
      "id": "laptop_status",
      "action": "store.hitld",
      "with": {
        "device": "example-laptop",
        "argv": ["store", "status"]
      }
    },
    {
      "id": "checkpoint_second",
      "action": "store.hitld",
      "with": {
        "device": "example-laptop",
        "argv": ["run", "checkpoint", "--host", "example-laptop"]
      }
    },
    {
      "id": "tablet_pull",
      "action": "store.hitld",
      "with": {
        "device": "example-tablet",
        "argv": ["store", "pull"]
      }
    },
    {
      "id": "tablet_ledger",
      "action": "store.hitld",
      "with": {
        "device": "example-tablet",
        "argv": ["ledger", "tail", "--limit", "20"]
      }
    },
    {
      "id": "tablet_status",
      "action": "store.hitld",
      "with": {
        "device": "example-tablet",
        "argv": ["store", "status"]
      }
    },
    {
      "id": "tablet_push",
      "action": "store.hitld",
      "with": {
        "device": "example-tablet",
        "argv": ["store", "push"]
      }
    }
  ],
  "graders": [
    {
      "id": "first-push-by-the-enrolled-device",
      "grader": "equals",
      "with": {
        "path": "steps.checkpoint_first.result.store_sync.push.result",
        "value": "pushed"
      }
    },
    {
      "id": "refused-before-it-asks",
      "grader": "equals",
      "with": {
        "path": "steps.tablet_push_unenrolled.result.error",
        "value": "device-not-enrolled"
      }
    },
    {
      "id": "the-request-is-on-the-branch",
      "grader": "equals",
      "with": {
        "path": "steps.tablet_request.result.request.pushed",
        "value": true
      }
    },
    {
      "id": "no-key-in-the-result",
      "grader": "equals",
      "with": {
        "path": "steps.tablet_request.result.key.where",
        "value": "environment"
      }
    },
    {
      "id": "not-the-first-device-so-no-self-ask",
      "grader": "equals",
      "with": {
        "path": "steps.tablet_request.result.decision",
        "value": null
      }
    },
    {
      "id": "a-request-is-not-an-approval",
      "grader": "equals",
      "with": {
        "path": "steps.tablet_push_requested.result.error",
        "value": "device-not-enrolled"
      }
    },
    {
      "id": "status-lists-the-request",
      "grader": "equals",
      "with": {
        "path": "steps.laptop_status_requested.result.devices.requests[*].name",
        "value": ["example-tablet"]
      }
    },
    {
      "id": "a-request-is-never-a-recipient",
      "grader": "equals",
      "with": {
        "path": "steps.laptop_push_requested.result.recipients",
        "value": 1
      }
    },
    {
      "id": "the-requester-opens-nothing",
      "grader": "equals",
      "with": {
        "path": "steps.remote_requested.opens.example-tablet",
        "value": 0
      }
    },
    {
      "id": "the-request-goes-to-the-owner",
      "grader": "equals",
      "with": {
        "path": "steps.laptop_ask.result.asked[*].name",
        "value": ["example-tablet"]
      }
    },
    {
      "id": "a-device-decision-never-takes-a-default",
      "grader": "equals",
      "with": {
        "path": "steps.laptop_sweep.result.applied",
        "value": []
      }
    },
    {
      "id": "the-owner-approved-it",
      "grader": "equals",
      "with": {
        "path": "steps.answer.answered[0].device.event",
        "value": "approved"
      }
    },
    {
      "id": "laptop-is-due-a-push",
      "grader": "equals",
      "with": {
        "path": "steps.laptop_status.result.push_due",
        "value": true
      }
    },
    {
      "id": "nothing-new-is-still-pushed",
      "grader": "equals",
      "with": {
        "path": "steps.checkpoint_second.result.store_sync.push.result",
        "value": "pushed"
      }
    },
    {
      "id": "opens-what-follows-the-answer",
      "grader": "equals",
      "with": {
        "path": "steps.tablet_pull.result.ok",
        "value": true
      }
    },
    {
      "id": "reads-the-whole-history",
      "grader": "matches",
      "with": {
        "path": "steps.tablet_ledger.result.events[*].text",
        "pattern": "Recorded before example-tablet joined"
      }
    },
    {
      "id": "knows-it-is-enrolled",
      "grader": "equals",
      "with": {
        "path": "steps.tablet_status.result.device.enrolled",
        "value": true
      }
    },
    {
      "id": "may-push-now",
      "grader": "matches",
      "with": {
        "path": "steps.tablet_push.result.result",
        "pattern": "^(pushed|up-to-date)$"
      }
    }
  ]
}
