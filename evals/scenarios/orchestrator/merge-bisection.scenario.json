{
  "schema_version": 1,
  "id": "orchestrator/merge-bisection",
  "suite": "orchestrator",
  "category": "merge-queue",
  "description": "The merge queue keeps main green: a semantic conflict goes back to its executor, a conflict confined to a generated file is regenerated rather than merged, a batch that fails the full suite is bisected to the one branch that broke it, and main moves only to the tested commit of the rest.",
  "mode": "offline",
  "fixture": { "generator": "repo", "options": {} },
  "steps": [{ "id": "queue", "action": "orchestrator.merge", "with": {} }],
  "graders": [
    {
      "id": "merged-the-good",
      "grader": "equals",
      "with": { "path": "steps.queue.merged", "value": ["W-1", "W-3"] }
    },
    {
      "id": "culprit-named",
      "grader": "contains",
      "with": {
        "path": "steps.queue.rejected",
        "value": { "item": "W-2", "reason": "suite", "files": [] }
      }
    },
    {
      "id": "semantic-conflict-sent-back",
      "grader": "contains",
      "with": {
        "path": "steps.queue.rejected",
        "value": { "item": "W-4", "reason": "conflict", "files": ["src/b.js"] }
      }
    },
    {
      "id": "generated-regenerated",
      "grader": "equals",
      "with": { "path": "steps.queue.main_files", "value": "a.js\nb.js\nc.js" }
    },
    {
      "id": "no-incident",
      "grader": "equals",
      "with": { "path": "steps.queue.incident", "value": null }
    },
    {
      "id": "main-is-tested",
      "grader": "equals",
      "with": { "path": "steps.queue.main_head_tested", "value": true }
    },
    {
      "id": "bisected",
      "grader": "equals",
      "with": { "path": "steps.queue.bisected", "value": true }
    }
  ]
}
