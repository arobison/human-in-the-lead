{
  "schema_version": 1,
  "id": "orchestrator/merge-flake-preexisting",
  "suite": "orchestrator",
  "category": "merge-queue",
  "description": "A full suite fails, then passes on the same commit, and the same test fails on the batch's base too: a pre-existing flake (design 14.7). The branch is not blamed and the batch merges.",
  "mode": "offline",
  "fixture": { "generator": "repo", "options": {} },
  "steps": [{ "id": "queue", "action": "orchestrator.merge", "with": { "flaky": "alternating" } }],
  "graders": [
    {
      "id": "merged",
      "grader": "equals",
      "with": { "path": "steps.queue.merged", "value": ["W-1"] }
    },
    {
      "id": "preexisting",
      "grader": "equals",
      "with": { "path": "steps.queue.flake_outcomes", "value": ["preexisting"] }
    },
    {
      "id": "not-blamed",
      "grader": "count",
      "with": { "path": "steps.queue.rejected", "equals": 0 }
    }
  ]
}
