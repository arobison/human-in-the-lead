{
  "schema_version": 1,
  "id": "orchestrator/dispatch-refill",
  "suite": "orchestrator",
  "category": "dispatch",
  "description": "The orchestrator dispatches from the head of the ready queue up to the cap and refills a slot only on a completion notice: one wait per dispatch, never more running than the cap (one at a time without parallel subagents), dependencies respected, and every dispatch reported in the ledger.",
  "mode": "offline",
  "harness": { "profiles": ["full", "minimal"] },
  "fixture": { "generator": "repo", "options": {} },
  "steps": [
    {
      "id": "cycle",
      "action": "orchestrator.cycle",
      "with": {
        "cap": 2,
        "items": [
          {
            "id": "W-1",
            "kind": "work",
            "state": "planned",
            "classification": "public",
            "touches": ["src/a.js"],
            "body": "\n## Done when\n\n`npm test` passes.\n\n## Plan\n\nChange `src/a.js`.\n"
          },
          {
            "id": "W-2",
            "kind": "work",
            "state": "planned",
            "classification": "public",
            "touches": ["src/b.js"],
            "body": "\n## Done when\n\n`npm test` passes.\n\n## Plan\n\nChange `src/b.js`.\n"
          },
          {
            "id": "W-3",
            "kind": "work",
            "state": "planned",
            "classification": "public",
            "touches": ["src/c.js"],
            "body": "\n## Done when\n\n`npm test` passes.\n\n## Plan\n\nChange `src/c.js`.\n"
          },
          {
            "id": "W-4",
            "kind": "work",
            "state": "planned",
            "classification": "public",
            "needs": ["W-1"],
            "touches": ["src/d.js"],
            "body": "\n## Done when\n\n`npm test` passes.\n\n## Plan\n\nChange `src/d.js`.\n"
          }
        ]
      }
    }
  ],
  "graders": [
    {
      "id": "all-done",
      "grader": "count",
      "with": { "path": "steps.cycle.remaining", "equals": 0 }
    },
    {
      "id": "four-dispatches",
      "grader": "equals",
      "with": { "path": "steps.cycle.dispatches", "value": 4 }
    },
    { "id": "no-polling", "grader": "equals", "with": { "path": "steps.cycle.waits", "value": 4 } },
    {
      "id": "all-reported",
      "grader": "equals",
      "with": { "path": "steps.cycle.reported", "value": 4 }
    },
    {
      "id": "nothing-left-running",
      "grader": "equals",
      "with": { "path": "steps.cycle.in_flight", "value": 0 }
    },
    {
      "id": "dependency-last",
      "grader": "equals",
      "with": { "path": "steps.cycle.order[3]", "value": "W-4" }
    },
    {
      "id": "within-cap",
      "grader": "equals",
      "with": { "path": "steps.cycle.within_cap", "value": true }
    }
  ]
}
