{
  "schema_version": 1,
  "id": "orchestrator/first-run-walk-through",
  "suite": "orchestrator",
  "category": "settings",
  "description": "The first-run walk-through (design 13.4): with no person or machine file the setup is not done; the orchestrator detects the machine, writes both files through config write with the answers given, and config explain shows them and says setup is done. A dispatched executor cannot write them.",
  "mode": "offline",
  "steps": [
    { "id": "consumer", "action": "orchestrator.consumer", "with": { "setup": false } },
    {
      "id": "before",
      "action": "orchestrator.cli",
      "with": { "argv": ["config", "explain", "--json"] }
    },
    {
      "id": "detect",
      "action": "orchestrator.cli",
      "with": { "argv": ["machine", "detect"], "fake_machine": true }
    },
    {
      "id": "executor_person",
      "action": "orchestrator.cli",
      "with": {
        "argv": [
          "config",
          "write",
          "person",
          "--data",
          "{\"schema_version\":1,\"max_executors\":2}"
        ],
        "as_executor": true
      }
    },
    {
      "id": "executor_machine",
      "action": "orchestrator.cli",
      "with": {
        "argv": [
          "config",
          "write",
          "machine",
          "--data",
          "{\"schema_version\":1,\"kind\":\"workstation\",\"cores\":4}"
        ],
        "as_executor": true
      }
    },
    {
      "id": "still_missing",
      "action": "orchestrator.cli",
      "with": { "argv": ["config", "explain", "--json"] }
    },
    {
      "id": "person",
      "action": "orchestrator.cli",
      "with": {
        "argv": [
          "config",
          "write",
          "person",
          "--data",
          "{\"schema_version\":1,\"max_executors\":2,\"quota\":{\"reserve\":0.3}}"
        ]
      }
    },
    {
      "id": "machine",
      "action": "orchestrator.cli",
      "with": {
        "argv": [
          "config",
          "write",
          "machine",
          "--data",
          "{\"schema_version\":1,\"kind\":\"workstation\",\"max_executors\":2,\"cores\":4,\"memory_ceiling_mb\":8192}"
        ]
      }
    },
    {
      "id": "after",
      "action": "orchestrator.cli",
      "with": { "argv": ["config", "explain", "--json"] }
    },
    {
      "id": "text",
      "action": "orchestrator.cli",
      "with": { "argv": ["config", "explain"] }
    }
  ],
  "graders": [
    {
      "id": "not-done-at-first",
      "grader": "equals",
      "with": { "path": "steps.before.result.setup.done", "value": false }
    },
    {
      "id": "both-missing",
      "grader": "count",
      "with": { "path": "steps.before.result.setup.missing", "equals": 2 }
    },
    {
      "id": "detect-proposes",
      "grader": "equals",
      "with": { "path": "steps.detect.result.kind", "value": "workstation" }
    },
    {
      "id": "detect-writes-nothing",
      "grader": "equals",
      "with": { "path": "steps.detect.result.written", "value": false }
    },
    {
      "id": "executor-person-refused",
      "grader": "equals",
      "with": { "path": "steps.executor_person.result.error", "value": "refused" }
    },
    {
      "id": "executor-machine-refused",
      "grader": "equals",
      "with": { "path": "steps.executor_machine.result.error", "value": "refused" }
    },
    {
      "id": "refused-writes-nothing",
      "grader": "equals",
      "with": { "path": "steps.still_missing.result.setup.done", "value": false }
    },
    {
      "id": "person-written",
      "grader": "equals",
      "with": { "path": "steps.person.result.written", "value": true }
    },
    {
      "id": "machine-written",
      "grader": "equals",
      "with": { "path": "steps.machine.result.written", "value": true }
    },
    {
      "id": "done-after",
      "grader": "equals",
      "with": { "path": "steps.after.result.setup.done", "value": true }
    },
    {
      "id": "reserve-from-person",
      "grader": "matches",
      "with": { "path": "steps.text.result.text", "pattern": "reserve.*0\\.3.*\\[person\\]" }
    }
  ]
}
