{
  "schema_version": 1,
  "id": "security/expired-risk-is-a-decision",
  "piece": "security",
  "category": "security-gate",
  "description": "Accepting a real finding needs an answered decision item. A finding the owner accepted merges until its expiry; past the expiry it becomes a decision for the owner, without blocking unrelated changes.",
  "mode": "offline",
  "fixture": {
    "generator": "repo",
    "options": {}
  },
  "steps": [
    {
      "id": "repo",
      "action": "security.repo",
      "with": {
        "main": {
          "src/app.js": "export const run = (x) => UNSAFE(x);\nexport const UNSAFE = (x) => x;\n"
        },
        "branches": [
          {
            "branch": "hitld/W-1-adds",
            "item": "W-1",
            "files": {
              "src/new.js": "import { UNSAFE } from './app.js';\nexport const handle = (input) => UNSAFE(input);\n"
            }
          },
          {
            "branch": "hitld/W-2-clean",
            "item": "W-2",
            "files": {
              "src/two.js": "export const two = 2;\n"
            }
          }
        ]
      }
    },
    {
      "id": "first",
      "action": "security.merge",
      "with": {
        "branches": ["hitld/W-1-adds"],
        "now": "2030-01-01T00:00:00Z"
      }
    },
    {
      "id": "unanswered",
      "action": "security.accept",
      "with": {
        "path": "src/new.js",
        "expires": "2030-03-01",
        "reason": "fix planned with the parser rewrite",
        "decision": {
          "id": "W-9",
          "kind": "decision",
          "state": "planned"
        },
        "now": "2030-01-01T00:00:00Z"
      }
    },
    {
      "id": "accept",
      "action": "security.accept",
      "with": {
        "path": "src/new.js",
        "expires": "2030-03-01",
        "reason": "fix planned with the parser rewrite",
        "decision": {
          "id": "W-9",
          "kind": "decision",
          "state": "done",
          "answer": "B",
          "answered_at": "2030-01-01T00:00:00Z",
          "answered_by": "owner"
        },
        "now": "2030-01-01T00:00:00Z"
      }
    },
    {
      "id": "accepted",
      "action": "security.merge",
      "with": {
        "branches": ["hitld/W-1-adds"],
        "now": "2030-01-02T00:00:00Z"
      }
