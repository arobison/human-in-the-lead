    {
      "id": "before",
      "action": "security.expired",
      "with": {
        "now": "2030-02-01T00:00:00Z"
      }
    },
    {
      "id": "after",
      "action": "security.merge",
      "with": {
        "branches": ["hitld/W-2-clean"],
        "now": "2030-03-02T00:00:00Z"
      }
    }
