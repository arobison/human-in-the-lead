          "feedback",
          "--kind",
          "friction",
          "--words",
          "hitld asked @casey-q twice about `src/billing/invoice.js` in fixture-repo.",
          "--refs",
          "D-3",
          "--store",
          "store"
        ]
      }
    },
    {
      "id": "name",
      "action": "feedback.cli",
      "with": {
        "argv": [
          "feedback",
          "draft",
          "FB-1",
          "--draft",
          "{\"title\": \"A low-stakes question reached the person instead of being decided\", \"area\": \"decision rights\", \"what_happened\": \"The orchestrator in fixture-repo asked the same question twice.\", \"expected\": \"A call made and logged, as the decision rules allow.\", \"classification\": \"public\"}",
          "--store",
          "store"
        ]
      }
    },
    {
      "id": "path",
      "action": "feedback.cli",
      "with": {
        "argv": [
          "feedback",
          "draft",
          "FB-2",
          "--draft",
          "{\"title\": \"A low-stakes question reached the person instead of being decided\", \"area\": \"decision rights\", \"what_happened\": \"It asked twice about src/billing/invoice.js.\", \"expected\": \"A call made and logged, as the decision rules allow.\", \"classification\": \"public\"}",
          "--store",
          "store"
