        "value": "fixture-repo"
      }
    },
    {
      "id": "path-withheld",
      "grader": "equals",
      "with": {
        "path": "steps.path.result.state",
        "value": "withheld"
      }
    },
    {
      "id": "person-withheld",
      "grader": "equals",
      "with": {
        "path": "steps.person.result.state",
        "value": "withheld"
      }
    },
    {
      "id": "person-reason",
      "grader": "matches",
      "with": {
        "path": "steps.person.result.reasons[*]",
        "pattern": "casey-q"
      }
    },
    {
      "id": "not-public-withheld",
      "grader": "equals",
      "with": {
        "path": "steps.classed.result.state",
        "value": "withheld"
      }
    },
    {
      "id": "approval-refused",
      "grader": "equals",
      "with": {
        "path": "steps.approve.result.error",
        "value": "not_drafted"
      }
    },
    {
      "id": "nothing-filed",
      "grader": "equals",
      "with": {
        "path": "steps.outbox.count",
        "value": 0
      }
    }
