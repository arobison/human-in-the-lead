{
  "$id": "opportunity",
  "title": "Opportunity",
  "description": "A shaped cluster of signals (design part 3.2). Shares the tracker number space. Built in milestone M6; the schema is here so the model is complete.",
  "x-hitld-schema-version": 1,
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common#/$defs/schemaVersion" },
    "id": { "$ref": "common#/$defs/id" },
    "kind": { "const": "opportunity" },
    "title": { "$ref": "common#/$defs/text" },
    "problem": { "description": "In the user's terms.", "$ref": "common#/$defs/text" },
    "signals": {
      "type": "array",
      "items": { "$ref": "common#/$defs/signalId" },
      "uniqueItems": true
    },
    "evidence": {
      "description": "Signal, run and study IDs; research notes with sources and dates read.",
      "$ref": "common#/$defs/texts"
    },
    "options": {
      "description": "Each with its trade-offs. Always includes \"do nothing\" with its cost of delay.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "$ref": "common#/$defs/text" },
          "tradeoffs": { "$ref": "common#/$defs/text" }
        },
        "required": ["label", "tradeoffs"],
        "additionalProperties": false
      }
    },
    "value": {
      "description": "In the project's value units (design part 22, Q18).",
      "type": "number",
      "minimum": 0
    },
    "confidence": { "description": "A probability.", "type": "number", "minimum": 0, "maximum": 1 },
    "cost_of_delay": {
      "type": "object",
      "properties": {
        "profile": { "enum": ["standard", "urgent", "fixed-date", "intangible"] },
        "rate": { "type": "number", "minimum": 0 },
        "date": { "$ref": "common#/$defs/timestamp" }
      },
      "required": ["profile"],
      "additionalProperties": false
    },
    "category": { "$ref": "common#/$defs/name" },
    "appetite_tokens": { "$ref": "common#/$defs/tokens" },
    "outcome_measures": { "$ref": "common#/$defs/texts" },
    "no_gos": { "$ref": "common#/$defs/texts" },
    "rabbit_holes": { "$ref": "common#/$defs/texts" },
    "state": { "enum": ["raw", "shaping", "shaped", "bet", "parked", "rejected"] },
    "bet_by": { "$ref": "common#/$defs/person" },
    "bet_decision": { "$ref": "common#/$defs/id" },
    "judgements": { "$ref": "common#/$defs/judgements" },
    "revisions": {
      "description": "Each change to value or confidence after shaping began, with its reason and evidence.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": { "$ref": "common#/$defs/timestamp" },
          "field": { "enum": ["value", "confidence"] },
          "from": { "type": "number" },
          "to": { "type": "number" },
          "reason": { "$ref": "common#/$defs/text" },
          "evidence": { "$ref": "common#/$defs/texts" }
        },
        "required": ["at", "field", "from", "to", "reason"],
        "additionalProperties": false
      }
    },
    "classification": { "$ref": "common#/$defs/classification" }
  },
  "required": ["schema_version", "id", "kind", "problem", "state", "classification"],
  "additionalProperties": false
}
