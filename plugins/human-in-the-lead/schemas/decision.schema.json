{
  "$id": "decision",
  "title": "Decision",
  "description": "An item of kind decision: a question for a decider (design part 3.2). Proposed while being framed, Planned once asked, Done when answered, Dropped if mooted. Derived fields (blocks, cost_of_delay_rate) are never stored.",
  "x-hitld-schema-version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common#/$defs/id"
    },
    "kind": {
      "const": "decision"
    },
    "title": {
      "$ref": "common#/$defs/text"
    },
    "parent": {
      "$ref": "common#/$defs/id"
    },
    "state": {
      "$ref": "common#/$defs/itemState"
    },
    "owner": {
      "description": "The human accountable, if not the project owner.",
      "$ref": "common#/$defs/person"
    },
    "area": {
      "$ref": "common#/$defs/name"
    },
    "category": {
      "description": "Portfolio category (design part 1.3).",
      "$ref": "common#/$defs/name"
    },
    "classification": {
      "$ref": "common#/$defs/classification"
    },
    "opened_from": {
      "description": "Signal, opportunity or decision IDs this was opened from.",
      "$ref": "common#/$defs/ids"
    },
    "needs": {
      "description": "IDs that must be Done before this is ready.",
      "$ref": "common#/$defs/ids"
    },
    "question": {
      "description": "One sentence that stands alone.",
      "$ref": "common#/$defs/text"
    },
    "context": {
      "description": "Two to five sentences: what is known, what prompted it.",
      "$ref": "common#/$defs/text"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "$ref": "common#/$defs/text"
          },
          "what_happens": {
            "$ref": "common#/$defs/text"
          },
          "cost": {
            "$ref": "common#/$defs/text"
          },
          "reversible": {
            "type": "boolean"
          }
        },
        "required": ["label", "what_happens"],
        "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "option": {
          "$ref": "common#/$defs/text"
        },
        "why": {
          "$ref": "common#/$defs/text"
        }
      },
      "required": ["option", "why"],
      "additionalProperties": false
    },
    "precedent_offer": {
      "description": "The generalization offered with the question (design part 4.3 and Q3). The decider confirms it with the answer, and then it becomes a precedent without a second round trip.",
      "type": "object",
      "properties": {
        "summary": {
          "description": "What the offer line names: \"Future cases like this (<summary>): treat the same way?\"",
          "$ref": "common#/$defs/text"
        },
        "rule": {
          "description": "\"When <conditions>, do <action>\", in plain language. The action is what the precedent applies.",
          "$ref": "common#/$defs/text"
        },
        "conditions": { "$ref": "precedent#/properties/conditions" },
        "exceptions": { "$ref": "precedent#/properties/exceptions" },
        "scope": { "$ref": "precedent#/properties/scope" }
      },
      "required": ["summary", "rule", "conditions"],
      "additionalProperties": false
    },
    "decider": {
      "description": "\"owner\", an area owner's contributor ID, or a named role.",
      "$ref": "common#/$defs/text"
    },
    "rights_basis": {
      "$ref": "common#/$defs/rightsBasis"
    },
    "reversibility": {
      "enum": ["two-way", "one-way"]
    },
    "default_if_unanswered": {
      "description": "Two-way doors only: the option taken, and logged, if the deadline passes.",
      "type": "object",
      "properties": {
        "option": {
          "$ref": "common#/$defs/text"
        },
        "deadline": {
          "$ref": "common#/$defs/timestamp"
        }
      },
      "required": ["option", "deadline"],
      "additionalProperties": false
    },
    "answer": {
      "$ref": "common#/$defs/text"
    },
    "rationale": {
      "$ref": "common#/$defs/text"
    },
    "answered_at": {
      "$ref": "common#/$defs/timestamp"
    },
    "answered_via": {
      "description": "The channel the answer came through.",
      "$ref": "common#/$defs/text"
    },
    "precedent": {
      "description": "The precedent created from this decision, if any.",
      "$ref": "common#/$defs/precedentId"
    },
    "resolved_by_precedent": {
      "$ref": "common#/$defs/precedentId"
    }
  },
  "required": ["schema_version", "id", "kind", "title", "state", "classification"],
  "additionalProperties": false
}
