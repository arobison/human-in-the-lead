{
  "schema_version": 1,
  "id": "orchestrator/merge-flake",
  "suite": "orchestrator",
  "category": "merge-queue",
  "description": "A full suite that fails and then passes on the same commit is a flake candidate, and the base comparison decides (design 14.7). Here the test never fails again, on main or on the candidate: the comparison is inconclusive, so it is recorded and counted, nobody is blamed, and the batch merges.",
  "mode": "offline",
  "fixture": { "generator": "repo", "options": {} },
  "steps": [{ "id": "queue", "action": "orchestrator.merge", "with": { "flaky": true } }],
  "graders": [
    {
      "id": "merged",
      "grader": "equals",
      "with": { "path": "steps.queue.merged", "value": ["W-1"] }
    },
    {
      "id": "inconclusive",
      "grader": "equals",
      "with": { "path": "steps.queue.flake_outcomes", "value": ["inconclusive"] }
    },
    {
      "id": "not-blamed",
      "grader": "count",
      "with": { "path": "steps.queue.rejected", "equals": 0 }
    },
    {
      "id": "recorded",
      "grader": "equals",
      "with": { "path": "steps.queue.flakes", "value": 1 }
    }
  ]
}
